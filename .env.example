# Server
PORT=4000
NODE_ENV=development

# MongoDB
MONGO_URI=mongodb://127.0.0.1:27017/online_exam_system

# Auth
JWT_SECRET=replace-this-with-a-long-random-string
JWT_EXPIRES_IN=8h

# Grading
# Max submissions accepted in a single bulk-grading request
BULK_GRADE_LIMIT=500

# CORS (comma separated origins, * to allow all)
CORS_ORIGIN=*
